{
  "manifest_version": 3,
  "name": "حاضر المعلم",
  "version": "3.0.1",
  "description": "يسحب اجتماعات Teams من تقويم Outlook، ويفتح كل حصة في موعدها، ويعطّل المايك والكاميرا للحضور، ويفتح مقطع الدرس، ويغلق الاجتماع عند نهايته — من الأحد إلى الخميس، آليًا.",
  "permissions": [
    "alarms",
    "notifications",
    "power",
    "scripting",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://outlook.office.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "حاضر المعلم",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "teams-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "teams.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office365.com/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "outlook.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "share-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "اعرض تبويب المقطع للطلاب في Teams",
      "global": true
    }
  },
  "key": ""
}